port: 3001
public_url: "http://localhost:3001"

upstreams:
  openai:
    type: openai
    base_url: "https://api.openai.com/v1"
    api_key: "${OPENAI_API_KEY}"

  anthropic:
    type: anthropic
    base_url: "https://api.anthropic.com"
    api_key: "${ANTHROPIC_API_KEY}"

models:
  gpt-4o:
    upstream: openai
    model: "gpt-4o"

  claude-sonnet:
    upstream: anthropic
    model: "claude-3-5-sonnet-20241022"
    fallback: gpt-4o
    metadata:
      name: "Claude Sonnet"
      reasoning: false
      input: ["text", "images"]
      context_window: 200000
      max_tokens: 8192

usage_tracking:
  enabled: true
  retention_hours: 24