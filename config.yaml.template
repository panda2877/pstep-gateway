port: 3001
public_url: "http://localhost:3001"

upstreams:
  openai:
    type: openai
    base_url: "https://api.openai.com/v1"
    api_key: "${OPENAI_API_KEY}"

  anthropic:
    type: anthropic
    base_url: "https://api.anthropic.com/v1"
    api_key: "${ANTHROPIC_API_KEY}"

  deepseek:
    type: openai
    base_url: "https://api.deepseek.com/v1"
    api_key: "${DEEPSEEK_API_KEY}"

  minimax:
    type: anthropic
    base_url: "https://api.minimax.io/anthropic"
    api_key: "${MINIMAX_API_KEY}"

models:
  gpt-4o:
    upstream: openai
    model: "gpt-4o"

  claude-sonnet:
    upstream: anthropic
    model: "claude-3-5-sonnet-20241022"
    fallback: gpt-4o
    metadata:
      name: "Claude Sonnet"
      reasoning: false
      input: ["text", "images"]
      context_window: 200000
      max_tokens: 8192

  deepseek-chat:
    upstream: deepseek
    model: "deepseek-chat"

  minimax-abab:
    upstream: minimax
    model: "abab6.5s-chat"

# Standard Base URLs - Provider Passthrough
# These routes allow direct access to provider APIs:
# - /provider/openai/v1/* -> https://api.openai.com/v1/*
# - /provider/anthropic/v1/* -> https://api.anthropic.com/v1/*
# - /provider/deepseek/v1/* -> https://api.deepseek.com/v1/*
# - /provider/minimax/anthropic/* -> https://api.minimax.io/anthropic/*

usage_tracking:
  enabled: true
  retention_hours: 24