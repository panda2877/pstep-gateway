{
  "name": "pstep-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pstep Model Gateway — API key management, routing, failover, usage tracking",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "docker:build": "docker build -t pstep-gateway .",
    "docker:run": "docker run -p 3001:3001 --env-file .env pstep-gateway"
  },
  "dependencies": {
    "fastify": "^5.3.0",
    "@fastify/cors": "^11.0.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panda2877/pstep-gateway.git"
  }
}