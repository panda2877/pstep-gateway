# =============================================================================
# Pstep Gateway — slot B (蓝绿部署的"绿"位)
#
# 与 slot A 互为备份：同一份镜像、不同 ContainerName、不同 host volume、
# 不同 PublishPort。每次 deploy 由 deploy 脚本切 nginx upstream 决定
# active 端口 (13004 ↔ 13005)。
#
# 关键差异（相对 slot A）：
#   - ContainerName: pstep-gateway-b
#   - PublishPort:  127.0.0.1:13005:3002  (仅本机；避开 :3002/3003
#                     因为 nginx 占了，避开 13002/13003 因为 frps 占了)
#   - Volume:       /var/lib/pstep-gateway-shared (与 slot A 共享，确保配置一致)
#   - GATEWAY_PORT: 3002  (容器内仍跑 3002；通过 127.0.0.1:13005 暴露)
#
# 服务器部署位置: /etc/containers/systemd/pstep/pstep-gateway-b.container
# =============================================================================

[Unit]
Description=Pstep Gateway (slot B)
After=network-online.target
Wants=network-online.target

[Container]
Image=pstep-gateway:latest
ContainerName=pstep-gateway-b

# 与 slot A 同样的 netavark bridge。PublishPort 显式绑到 127.0.0.1
# 所以 slot B 仅本机可见，外部不可达 —— 避免 standby 时被直连绕过 nginx。
Network=bridge

# 宿主机 127.0.0.1:13005 → 容器内 3002。
# 避开 :3002/3003：nginx 已占。避开 13002/13003：本机 frps 占用。
PublishPort=127.0.0.1:13005:3002

# Hardening
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
SecurityLabelDisable=true

Volume=/etc/pstep-gateway:/etc/pstep-gateway:ro
# 与 slot A 共享 /var/lib/pstep-gateway-shared 目录，确保配置修改
# 在蓝绿切换后仍然可见。
Volume=/var/lib/pstep-gateway-shared:/var/lib/pstep-gateway:rw

EnvironmentFile=/etc/pstep-gateway/env
Environment=RUST_LOG=info
Environment=CONFIG_PATH=/etc/pstep-gateway/config.yaml
Environment=GATEWAY_PORT=3002

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=130

[Install]
WantedBy=multi-user.target default.target
