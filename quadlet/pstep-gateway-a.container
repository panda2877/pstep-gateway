# =============================================================================
# Pstep Gateway — slot A (蓝绿部署的"蓝"位)
#
# 与 slot B 共享同一份 pstep-gateway:latest 镜像；区别仅在：
#   - ContainerName: pstep-gateway-a
#   - PublishPort:  127.0.0.1:13004:3002  (仅本机；避开 :3002 因为 nginx
#                     pstep-gateway 站点独占 0.0.0.0:3002；避开 13002/13003
#                     因为本机 frps 占了 13002)
#   - Volume:       /var/lib/pstep-gateway-a (独立 SQLite)
#   - GATEWAY_PORT: 3002       (覆盖 config.yaml 的 port；容器内仍跑 3002)
#
# 部署时两个 unit 一起被 install 上去；nginx upstream 决定哪个 slot 接收流量。
# 不接收流量的 slot 处于 "standby" 状态（仍在跑，但上游没有打到它）。
#
# 端口分配：
#   0.0.0.0:3002  → nginx pstep-gateway 站点 (公网入口)
#   127.0.0.1:13004 → slot A 容器 (仅 nginx upstream 访问)
#   127.0.0.1:13005 → slot B 容器 (仅 nginx upstream 访问)
#   0.0.0.0:3003  → nginx pstep-admin 站点 (前端 + /api/ 反代 → 3002)
#
# 服务器部署位置: /etc/containers/systemd/pstep/pstep-gateway-a.container
# =============================================================================

[Unit]
Description=Pstep Gateway (slot A)
After=network-online.target
Wants=network-online.target

[Container]
Image=pstep-gateway:latest
ContainerName=pstep-gateway-a

# netavark bridge 网络 + rootful。PublishPort 显式绑 127.0.0.1，
# 让 nginx 独占 0.0.0.0:3002（公网入口）。
Network=bridge

PublishPort=127.0.0.1:13004:3002

# Hardening
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
SecurityLabelDisable=true

# Config bind mount (server-side /etc/pstep-gateway/config.yaml)
# 必须 chmod 644 — distroless 容器内 UID 65532 无 /etc/passwd 项。
Volume=/etc/pstep-gateway:/etc/pstep-gateway:ro

# Writable scratch for usage_db (SQLite). The gateway creates /var/lib/pstep-gateway
# at startup; the host dir must be chown 65532:65532 to match the container user.
# Slot A 和 Slot B 共享 /var/lib/pstep-gateway-shared 目录，确保配置修改
# 在蓝绿切换后仍然可见。SQLite WAL 模式有文件锁保护，并发安全。
Volume=/var/lib/pstep-gateway-shared:/var/lib/pstep-gateway:rw

# Secrets injected via EnvironmentFile (chmod 600, host-managed).
# Required keys: MIMO_API_KEY (and any other upstream API keys referenced by ${VAR}
# in config.yaml). Missing entries resolve to empty string, which surfaces as 401/403.
EnvironmentFile=/etc/pstep-gateway/env
Environment=RUST_LOG=info
Environment=CONFIG_PATH=/etc/pstep-gateway/config.yaml
Environment=GATEWAY_PORT=3002

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=130

[Install]
WantedBy=multi-user.target default.target
