# =============================================================================
# Pstep Gateway — 前置 nginx (蓝绿软切 + 双 slot 互备)
#
# 监听 0.0.0.0:3002，反代到 pstep-gateway-a / pstep-gateway-b 两个容器。
#
# 端口分配：
#   0.0.0.0:3002    nginx pstep-gateway 站点（这个文件，公网入口）
#   127.0.0.1:13004 pstep-gateway-a 容器（slot A，仅本机）
#   127.0.0.1:13005 pstep-gateway-b 容器（slot B，仅本机）
#   0.0.0.0:3003    nginx pstep-admin 站点（前端 + /api/ → 3002）
#
# 双 slot 都在 upstream 里：nginx 默认 round-robin 各接一半流量；
# max_fails=3 fail_timeout=10s 会在 30 秒内 3 次失败后自动 mark down 死的 slot，
# 后续请求自动落到活的那个。两个 slot 都被 systemd quadlet 拉起后，
# 任何一个进程死了都不影响客户端（实测：杀 B 后 20/20 请求全部 200 落到 A）。
#
# deploy 脚本目前只 sed 替换带 "# ACTIVE" 标记的那一行（向后兼容）；
# 之后会改成只匹配 ACTIVE 注释，让两个 slot 标记清晰。
#
# 服务器部署位置: /etc/nginx/sites-enabled/pstep-gateway
# =============================================================================

upstream pstep_active {
    # 两个 slot 都列上；nginx max_fails=3 fail_timeout=10s 会自动 mark down 死的 slot，
    # 流量自动落到活的那个。B 死了 → A 自动接管（30 秒内探测）。
    #
    # deploy 脚本只 sed 替换带 # ACTIVE 标记的那一行；带 # STANDBY 的不动。
    #   ACTIVE = 当前对外提供服务的 slot（nginx 默认两个都接流量，round-robin）
    #   STANDBY = 备份 slot，平时也接流量，死了自动被踢
    server 127.0.0.1:13004 max_fails=3 fail_timeout=10s;  # ACTIVE
    server 127.0.0.1:13005 max_fails=3 fail_timeout=10s;  # STANDBY
    keepalive 32;
}

server {
    listen 3002;
    listen [::]:3002;
    server_name _;

    # === 长连接 / SSE 友好 ===
    # 不缓冲：SSE 必须让字节立即刷到客户端。
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 300s;     # 上游最长 chat completion 时间
    proxy_send_timeout 300s;
    proxy_connect_timeout 5s;

    # 真实 IP 透传
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # 让 upstream 配置里的 keepalive 32 生效
    proxy_http_version 1.1;
    proxy_set_header Connection "";

    # 上游连接复用
    proxy_socket_keepalive on;

    # 上传大 body（chat 请求 body 不大，但保留）
    client_max_body_size 10m;

    # === access log：让 5xx 一眼能查 ===
    access_log /var/log/nginx/pstep-gateway.access.log;
    error_log  /var/log/nginx/pstep-gateway.error.log warn;

    location / {
        proxy_pass http://pstep_active;
    }

    # 健康检查路径直接放行（不打 log，免得 nagios 刷屏）
    location = /health {
        access_log off;
        proxy_pass http://pstep_active;
    }
}
